{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ring-server/ring-server {:mvn/version "0.5.0"}
        ring/ring-devel {:mvn/version "1.8.2"}
        compojure/compojure {:mvn/version "1.6.2"}
        cryogen-flexmark/cryogen-flexmark {:mvn/version "0.1.5"}
        cryogen-core/cryogen-core {:mvn/version "0.5.1"}}
 :aliases {;; Build the site into public/: `clojure -M:build`
           :build {:main-opts ["-m" "cryogen.core"]}
           ;; Serve with live reload at http://localhost:3000/datajure-website/:
           ;; `clojure -X:serve`
           :serve {:exec-fn   cryogen.server/serve
                   :exec-args {:port 3000}}
           :serve-fast {:exec-fn   cryogen.server/serve
                        :exec-args {:port 3000, :fast true}}
           ;; nREPL on an ephemeral port (written to .nrepl-port): `clojure -M:nrepl`
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
                   :main-opts ["-m" "nrepl.cmdline" "--port" "0"]}
           ;; Run the snippets on the pages against this Datajure version and
           ;; compare their printed output: `clojure -M:check content/md/pages/*.md`
           :check {:replace-deps {org.clojure/clojure {:mvn/version "1.12.4"}
                                  com.github.clojure-finance/datajure {:mvn/version "2.7.12"}}
                   :replace-paths []
                   :main-opts ["script/check_pages.clj"]}}}
